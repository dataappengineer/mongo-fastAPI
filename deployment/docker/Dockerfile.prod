# Production Dockerfile for FastAPI MongoDB REST API
# This Dockerfile is optimized for production deployment on Kubernetes/Rancher

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY app/ ./app/
COPY scripts/ ./scripts/

# Expose port
EXPOSE 8000

# Production command
# - NO --reload flag (development only)
# - Multiple workers for better performance
# - Workers = (2 x CPU cores) + 1, default to 4 for typical deployments
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
