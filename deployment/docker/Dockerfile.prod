# Production Dockerfile for FastAPI MongoDB REST API
# This Dockerfile is optimized for production deployment on Kubernetes/Rancher

FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Copy requirements first for better caching
COPY requirements.txt .

# Install dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code and scripts
COPY app/ ./app/
COPY scripts/ ./scripts/
COPY docker-entrypoint.sh ./

RUN chmod +x /app/docker-entrypoint.sh

# Expose HTTP and HTTPS ports
EXPOSE 8000 8443

# Production entrypoint: auto-detects TLS certificates in /etc/tls or accepts custom commands
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD []
